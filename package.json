{
  "name": "laines-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/check-encoding.mjs && vite build",
    "check-encoding": "node scripts/check-encoding.mjs",
    "audit:journey": "node scripts/journey-audit.mjs",
    "guard:schema": "node scripts/check-runtime-schema-patches.mjs",
    "smoke:api": "node scripts/smoke-api.mjs",
    "drill:observability": "node scripts/observability-drill.mjs",
    "test:core": "npm --prefix server run build && node scripts/run-core-tests.mjs",
    "test:e2e:critical": "node scripts/e2e-critical.mjs",
    "test:e2e:avaliacoes": "node scripts/e2e-avaliacoes-finalizacao.mjs",
    "test:e2e:auth-session": "node scripts/e2e-auth-session.mjs",
    "test:e2e:roles": "node scripts/e2e-role-contract.mjs",
    "test:e2e:analytics": "node scripts/e2e-analytics.mjs",
    "test:e2e:analytics:local": "node scripts/e2e-analytics-local.mjs",
    "assess:security": "node scripts/security-assessment.mjs",
    "assess:perf": "node scripts/perf-load-assessment.mjs",
    "assess:browser": "node scripts/browser-assessment.mjs",
    "test:e2e:env": "node scripts/verify-e2e-env.mjs",
    "seed:e2e": "npm --prefix server run seed:e2e",
    "seed:loadtest": "node server/scripts/seed-load-usage.js",
    "seed:ci:users": "node -r ./server/node_modules/dotenv/config server/scripts/seed-ci-users.js dotenv_config_path=server/.env",
    "test:simulate:usage": "node scripts/simulate-usage.mjs",
    "test:all": "npm run test:core && npm run smoke:api && npm run test:e2e:critical && npm run test:e2e:avaliacoes && npm run test:e2e:auth-session && npm run test:e2e:roles && npm run test:e2e:analytics",
    "lint": "eslint . && node scripts/check-copy-permission-guardrails.mjs",
    "lint:css": "stylelint \"src/**/*.css\" --allow-empty-input",
    "guard:copy": "node scripts/check-copy-permission-guardrails.mjs",
    "lint:server": "npm --prefix server run lint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.1.0",
    "@tailwindcss/vite": "^4.1.18",
    "axios": "^1.13.2",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.25.0",
    "lucide-react": "^0.562.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.11.0",
    "recharts": "^3.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.23",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "playwright": "^1.58.2",
    "postcss": "^8.5.6",
    "stylelint": "^17.6.0",
    "stylelint-config-standard": "^40.0.0",
    "tailwindcss": "^4.1.18",
    "vite": "^7.2.4"
  },
  "overrides": {
    "picomatch": "^4.0.4"
  }
}
