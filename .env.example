# LAINES APP - exemplo de variaveis de ambiente

# Ambiente
NODE_ENV=development
PORT=4000
HOST=127.0.0.1

# Banco de dados
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=laines
DB_PASSWORD=laines_dev_password
DB_NAME=laines
DB_SYNC=false
DB_MIGRATIONS_RUN=true

# Seguranca
JWT_SECRET=troque-este-segredo
JWT_REFRESH_SECRET=troque-este-segredo-refresh
AUTH_NEW_FLOW_ENABLED=true
AUTH_REFRESH_COOKIE_SECURE=true

# Bootstrap de uso unico para o primeiro administrador.
# So execute em banco novo; o script aborta se ja houver admin ativo.
BOOTSTRAP_ADMIN_EMAIL=admin@laines.app
BOOTSTRAP_ADMIN_PASSWORD=TroqueEstaSenha123
BOOTSTRAP_ADMIN_NAME=Administrador LAINES

# Obrigatorio em producao. Nunca use "*" em producao.
# Exemplo: CORS_ORIGIN=https://laines.facisa.ufrn.br
CORS_ORIGIN=http://localhost:5173
