NODE_ENV=development
PORT=4000
DB_HOST=localhost
DB_PORT=5432
DB_USER=laines
DB_PASSWORD=change_me
DB_NAME=laines
DB_SYNC=false
DB_LOGGING=false
DB_POOL_MAX=60
DB_POOL_MIN=2
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONNECTION_TIMEOUT_MS=8000
# Recomendado manter true para prevenir drift de schema entre ambientes.
# Em producao, o script start:prod ja executa migration:run:prod antes de subir a API.
DB_MIGRATIONS_RUN=true
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=change_this_to_another_long_random_secret
JWT_REFRESH_EXPIRES_IN=14d
JWT_ISSUER=laines-api
JWT_AUDIENCE=laines-clients
JWT_CLOCK_TOLERANCE_SECONDS=5
AUTH_NEW_FLOW_ENABLED=true
AUTH_ACCESS_TOKEN_EXPIRES_IN=20m
# Opcoes: opaque (padrao, mais rapido) | jwt (legado)
AUTH_REFRESH_TOKEN_FORMAT=opaque
AUTH_REFRESH_COOKIE_NAME=laines_refresh_token
AUTH_REFRESH_COOKIE_PATH=/auth
AUTH_REFRESH_COOKIE_DOMAIN=
AUTH_REFRESH_COOKIE_SAMESITE=lax
# Em dev local com HTTP, mantenha false. Em producao deve ser true (HTTPS).
AUTH_REFRESH_COOKIE_SECURE=false
AUTH_ALLOW_PUBLIC_ACCESS_REQUEST=true
LOGIN_MAX_ATTEMPTS=5
LOGIN_BLOCK_SECONDS=300
LOGIN_STATE_TTL_SECONDS=86400
LOGIN_MAX_STATE_ENTRIES=5000
LOGIN_CLEANUP_INTERVAL_SECONDS=20
AUTH_PASSWORD_COMPARE_CONCURRENCY=24
AUTH_PASSWORD_COMPARE_SUCCESS_CACHE_MS=120000
AUTH_PASSWORD_COMPARE_CACHE_MAX_ENTRIES=3000
AUTH_GUARD_TOKEN_CACHE_ENABLED=true
AUTH_GUARD_TOKEN_CACHE_TTL_MS=800
AUTH_GUARD_TOKEN_CACHE_MAX_ENTRIES=2000
CORS_ORIGIN=http://localhost:5173
# Exemplo com mais de uma origem: CORS_ORIGIN=http://localhost:5173,http://localhost:5174
TRUST_PROXY=false
CSP_MODE=report-only
# Em producao usar: CSP_MODE=enforce (bloqueia violacoes; report-only so monitora)
CSP_POLICY=
CSP_REPORT_URI=/csp-report
MAINTENANCE_MODE=false
MAINTENANCE_BYPASS_TOKEN=
HEALTH_DB_CACHE_TTL_MS=1200
HTTP_BACKLOG=2048
OBSERVABILITY_DRILL_ENABLED=false
REQUEST_LOGS_ENABLED=false
OBSERVABILITY_PERSISTENCE_ENABLED=true
OBSERVABILITY_EVENTS_FILE=logs/observability-events.jsonl
OBSERVABILITY_MAX_EVENTS_FILE_BYTES=5242880
OBSERVABILITY_WEBHOOK_URL=
OBSERVABILITY_WEBHOOK_TIMEOUT_MS=3000
OBSERVABILITY_ALERT_EVAL_INTERVAL_MS=1000
OBSERVABILITY_ALERT_EVAL_MIN_REQUESTS=30
ACCESS_REQUEST_MAX_ATTEMPTS=5
ACCESS_REQUEST_WINDOW_SECONDS=900
ACCESS_REQUEST_COOLDOWN_SECONDS=900
ACCESS_REQUEST_DUPLICATE_WINDOW_HOURS=24
REALTIME_BROADCAST_ROLES=admin,coordenacao,presidente,vice,coord_atendimento,diretoria_marketing,diretoria_ensino,diretoria_pesquisa,diretoria_extensao,professor,profissional,pesquisador,colaborador,tecnico
UPLOAD_DIR=uploads
UPLOAD_PUBLIC_ACCESS=false
UPLOAD_BASE_URL=http://localhost:4000

# Avaliacao corporal por imagem. Use "local" apenas em desenvolvimento.
IMAGE_STORAGE_DRIVER=local
IMAGE_UPLOAD_BASE_URL=http://localhost:4000
IMAGE_UPLOAD_SIGNING_SECRET=troque-por-um-segredo-longo
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_IMAGE_BUCKET=laines-imagens-corporais
MINIO_REGION=us-east-1
MINIO_AUTO_CREATE_BUCKET=true
# Origem pública do MinIO usada no CSP do nginx via envsubst no deploy.
# Ex: https://minio.facisa.ufrn.br:9000  — vazio = driver local, sem MinIO externo.
MINIO_CSP_ORIGIN=

# API FastAPI do processador 3D. Sem esta URL, uploads funcionam mas nenhum
# resultado e fabricado; o job fica como aguardando_processador.
# Dev local (sem Docker): http://localhost:8001
# Docker Compose: http://image-processor:8001
IMAGE_PROCESSOR_URL=http://localhost:8001
IMAGE_PROCESSOR_TIMEOUT_MS=60000
IMAGE_PROCESSOR_TOKEN=troque-por-um-token-interno-longo-e-exclusivo
PROCESSOR_MAX_CONCURRENT_JOBS=2
PROCESSOR_MAX_PENDING_JOBS=8
# Obrigatorio ao usar MinIO: somente estes hosts podem fornecer capturas ao processador.
PROCESSOR_ALLOWED_SOURCE_HOSTS=localhost
# Tamanho físico do marcador ArUco impresso (cm). Padrão: 14,8 cm (A4 ao meio).
# Pode ser sobrescrito por avaliação via campo arucoMarkerSizeCm no payload.
ARUCO_MARKER_SIZE_CM=14.8
# Dicionário ArUco. Deve corresponder ao marcador impresso.
ARUCO_DICT_NAME=DICT_4X4_50
# ── Email (Gmail SMTP) ──────────────────────────────────────────────────────
# Deixe MAIL_ENABLED=false em dev/CI. Em producao, configure com App Password do Gmail.
# Requisito: ativar verificacao em 2 etapas na conta Gmail e gerar uma "Senha de app".
MAIL_ENABLED=false
MAIL_SMTP_HOST=smtp.gmail.com
MAIL_SMTP_PORT=587
MAIL_SMTP_USER=seuemail@gmail.com
MAIL_SMTP_PASS=xxxx xxxx xxxx xxxx
MAIL_FROM=LAINES <seuemail@gmail.com>
# Links de ativacao e recuperacao exigem HTTPS (HTTP permitido apenas em localhost).
APP_URL=https://laines.facisa.ufrn.br
