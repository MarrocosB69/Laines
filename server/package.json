{
  "name": "laines-server",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "start": "nest start",
    "start:dev": "nest start --watch",
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && nest build",
    "lint": "tsc --noEmit --project tsconfig.json",
    "seed": "npm run seed:mets && npm run seed:taco",
    "seed:mets": "ts-node -r tsconfig-paths/register -r dotenv/config src/database/seeds/mets.seed.ts dotenv_config_path=.env",
    "seed:taco": "ts-node -r tsconfig-paths/register -r dotenv/config src/database/seeds/taco.seed.ts dotenv_config_path=.env",
    "seed:e2e": "ts-node -r tsconfig-paths/register -r dotenv/config scripts/seed-e2e-users.ts dotenv_config_path=.env",
    "bootstrap:admin": "ts-node -r tsconfig-paths/register -r dotenv/config scripts/bootstrap-admin.ts dotenv_config_path=.env",
    "start:prod": "npm run migration:run:prod && node dist/main.js",
    "migration:generate": "typeorm-ts-node-commonjs -d src/database/typeorm.config.ts migration:generate ./src/database/migrations/Init",
    "migration:run": "typeorm-ts-node-commonjs -d src/database/typeorm.config.ts migration:run",
    "migration:run:prod": "node ./node_modules/typeorm/cli.js -d dist/database/typeorm.config.js migration:run"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.17",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.19",
    "@nestjs/jwt": "^11.0.1",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.17",
    "@nestjs/platform-socket.io": "^11.1.17",
    "@nestjs/typeorm": "^11.0.0",
    "@nestjs/websockets": "^11.1.17",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "jsonwebtoken": "^9.0.2",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdfkit": "^0.18.0",
    "pg": "^8.12.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.28"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.9",
    "@nestjs/testing": "^11.1.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.12.12",
    "@types/passport-jwt": "^4.0.1",
    "@types/socket.io": "^3.0.2",
    "chokidar": "^4.0.3",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "typeorm-ts-node-commonjs": "^0.3.20",
    "typescript": "^5.5.4"
  },
  "overrides": {
    "path-to-regexp": "^8.4.0",
    "socket.io-parser": "^4.2.6",
    "brace-expansion": "^2.0.3"
  }
}
